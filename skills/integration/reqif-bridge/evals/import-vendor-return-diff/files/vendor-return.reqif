              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>rs-ad-Status</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Checkout must not get slower (SH-02); 9000 purchases per minute is last year's year-end peak (SH-08).">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>rs-ad-Rationale</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Voucher validation response time at peak">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>rs-ad-Title</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
