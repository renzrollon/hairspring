            <SPEC-OBJECT-TYPE-REF>rs-sot-requirement</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="R-085" LAST-CHANGE="2026-11-12T14:01:47+08:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="R-085">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>rs-ad-ID</ATTRIBUTE-DEFINITION-STRING-REF>
