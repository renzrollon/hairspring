        <SPEC-OBJECT IDENTIFIER="R-041" LAST-CHANGE="2026-11-12T13:58:02+08:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="R-041">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>rs-ad-ID</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="F">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>rs-ad-Type</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>rs-ad-Text</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE>
                <xhtml:div>WHEN the POS sends a voucher validation request for a voucher in state Issued, the loyalty service shall return the voucher value <xhtml:b>and the voucher expiry date</xhtml:b> to the POS.</xhtml:div>
              </THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="S-02 (TillPoint interface spec v2.1)">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>rs-ad-Source</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="must">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>rs-ad-Priority</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="agreed">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>rs-ad-Status</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Cashiers apply a voucher only after the loyalty service has confirmed it.">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>rs-ad-Rationale</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Validate voucher at checkout">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>rs-ad-Title</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="TillPoint v2.2 shows the voucher expiry on the till screen, so we need it in the response.">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>vendor-ad-comment</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
